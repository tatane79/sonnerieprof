    "tip.body" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Všechny funkce Sonnerie Prof jsou zdarma. Pokud vám aplikace pomáhá každý den, můžete její vývoj podpořit dobrovolným spropitným."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle funktioner i Sonnerie Prof er gratis. Hvis appen hjælper dig i hverdagen, kan du støtte udviklingen med frivillige drikkepenge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alle Funktionen von Sonnerie Prof sind kostenlos. Wenn die App im Alltag hilft, kann ihre Entwicklung mit einem freiwilligen Trinkgeld unterstützt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "All Sonnerie Prof features are free. If the app helps you every day, you can support its development with an optional tip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Todas las funciones de Sonnerie Prof son gratuitas. Si la app te ayuda en el día a día, puedes apoyar su desarrollo con una propina opcional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Toutes les fonctions de Sonnerie Prof sont gratuites. Si l’app vous aide au quotidien, vous pouvez soutenir son développement avec un pourboire facultatif."
