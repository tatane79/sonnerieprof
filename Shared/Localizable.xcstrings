    "Un horaire par ligne. Les boutons ajoutent automatiquement une ligne à partir du dernier horaire saisi." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden čas na řádek. Tlačítka automaticky přidají řádek podle posledního zadaného času."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én tid pr. linje. Knapperne tilføjer automatisk en linje baseret på den senest indtastede tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Uhrzeit pro Zeile. Die Schaltflächen fügen automatisch eine Zeile auf Grundlage der zuletzt eingegebenen Uhrzeit hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One time per line. The buttons automatically add a line based on the last time entered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un horario por línea. Los botones añaden automáticamente una línea a partir del último horario introducido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un horaire par ligne. Les boutons ajoutent automatiquement une ligne à partir du dernier horaire saisi."
