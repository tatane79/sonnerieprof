    "Seuls le nom de l’établissement et les horaires de sonnerie sont publiés. La position et l’emploi du temps personnel ne sont jamais partagés." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Zveřejní se pouze název školy a časy zvonění. Poloha ani osobní rozvrh se nikdy nesdílí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Kun skolens navn og ringetider offentliggøres. Placeringen og det personlige skema deles aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Nur der Name der Schule und die Klingelzeiten werden veröffentlicht. Der Standort und der persönliche Stundenplan werden niemals geteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Only the school name and bell times are published. The location and personal timetable are never shared."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Solo se publican el nombre del centro educativo y los horarios de timbre. La ubicación y el horario personal nunca se comparten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Vengono pubblicati solo il nome della scuola e gli orari delle campanelle. La posizione e l’orario personale non vengono mai condivisi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Alleen de naam van de school en de beltijden worden gepubliceerd. De locatie en het persoonlijke lesrooster worden nooit gedeeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Publikowane są tylko nazwa szkoły i godziny dzwonków. Położenie i osobisty plan lekcji nigdy nie są udostępniane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Somente o nome da escola e os horários de sinal são publicados. A localização e o horário pessoal nunca são compartilhados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Apenas são publicados o nome da escola e os horários de toque. A localização e o horário pessoal nunca são partilhados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sunt publicate numai numele școlii și orele clopoțelului. Poziția și orarul personal nu sunt partajate niciodată."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Endast skolans namn och ringtider publiceras. Platsen och det personliga schemat delas aldrig."
          }
        }
      }
    },
