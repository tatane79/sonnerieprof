    "Saisissez les horaires jour par jour ou recopiez ceux du lundi sur le mardi, mercredi, jeudi, vendredi et samedi." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte časy po jednotlivých dnech nebo zkopírujte pondělní časy na úterý, středu, čtvrtek, pátek a sobotu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast tider dag for dag, eller kopier mandagens tider til tirsdag, onsdag, torsdag, fredag og lørdag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie die Zeiten Tag für Tag ein oder kopieren Sie die Montagszeiten auf Dienstag, Mittwoch, Donnerstag, Freitag und Samstag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter times day by day or copy Monday's times to Tuesday, Wednesday, Thursday, Friday and Saturday."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce los horarios día por día o copia los del lunes al martes, miércoles, jueves, viernes y sábado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez les horaires jour par jour ou recopiez ceux du lundi sur le mardi, mercredi, jeudi, vendredi et samedi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci gli orari giorno per giorno oppure copia quelli di lunedì su martedì, mercoledì, giovedì, venerdì e sabato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer de tijden per dag in of kopieer de tijden van maandag naar dinsdag, woensdag, donderdag, vrijdag en zaterdag."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wprowadzaj godziny dzień po dniu lub skopiuj godziny z poniedziałku na wtorek, środę, czwartek, piątek i sobotę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insira os horários de cada dia ou copie os de segunda-feira para terça, quarta, quinta, sexta e sábado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduza os horários dia a dia ou copie os de segunda-feira para terça, quarta, quinta, sexta e sábado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introdu orele zi cu zi sau copiază orele de luni pentru marți, miercuri, joi, vineri și sâmbătă."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange tider dag för dag eller kopiera måndagens tider till tisdag, onsdag, torsdag, fredag och lördag."
          }
        }
      }
    },
