    "Sonnerie Prof est conçue pour aider les enseignants à garder un œil sur le temps restant avant la prochaine sonnerie, directement depuis l’app ou l’écran verrouillé" : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnerie Prof pomáhá učitelům sledovat čas zbývající do dalšího zvonění přímo v aplikaci nebo na zamčené obrazovce."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnerie Prof hjælper lærere med at holde øje med tiden til næste ringning, direkte i appen eller på låseskærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnerie Prof hilft Lehrkräften, die verbleibende Zeit bis zum nächsten Klingeln im Blick zu behalten – direkt in der App oder auf dem Sperrbildschirm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnerie Prof is designed to help teachers keep an eye on the time remaining until the next bell, directly from the app or the Lock Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnerie Prof está diseñada para ayudar al profesorado a controlar el tiempo restante hasta el próximo timbre, directamente desde la app o la pantalla bloqueada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnerie Prof est conçue pour aider les enseignants à garder un œil sur le temps restant avant la prochaine sonnerie, directement depuis l’app ou l’écran verrouillé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnerie Prof è pensata per aiutare gli insegnanti a tenere d’occhio il tempo rimanente fino alla prossima campanella, direttamente dall’app o dalla schermata di blocco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnerie Prof helpt leerkrachten de resterende tijd tot de volgende bel in de gaten te houden, rechtstreeks vanuit de app of op het toegangsscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnerie Prof pomaga nauczycielom kontrolować czas pozostały do następnego dzwonka bezpośrednio w aplikacji lub na ekranie blokady."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sonnerie Prof foi criado para ajudar professores a acompanhar o tempo restante até o próximo sinal, diretamente no app ou na Tela Bloqueada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sonnerie Prof foi concebido para ajudar os professores a acompanhar o tempo restante até ao próximo toque, diretamente na app ou no ecrã bloqueado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnerie Prof îi ajută pe profesori să urmărească timpul rămas până la următorul clopoțel, direct din aplicație sau de pe ecranul de blocare."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sonnerie Prof hjälper lärare att hålla koll på tiden till nästa ringning, direkt i appen eller på låsskärmen."
          }
        }
      }
    },
