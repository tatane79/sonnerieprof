    "Pour un suivi fiable sur toute la journée, ajoutez aussi le widget « Sonnerie Prof » à l’écran verrouillé. iOS limite une Live Activity active à environ 8 heures." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro spolehlivé sledování po celý den přidejte také widget „Sonnerie Prof“ na zamčenou obrazovku. iOS omezuje aktivní Live Activity přibližně na 8 hodin."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For pålidelig visning hele dagen skal du også føje widgetten “Sonnerie Prof” til låseskærmen. iOS begrænser en aktiv Live Activity til cirka 8 timer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für eine zuverlässige Anzeige über den ganzen Tag fügen Sie auch das Widget „Sonnerie Prof“ zum Sperrbildschirm hinzu. iOS begrenzt eine aktive Live Activity auf etwa 8 Stunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For reliable all-day tracking, also add the “Sonnerie Prof” widget to the Lock Screen. iOS limits an active Live Activity to about 8 hours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para un seguimiento fiable durante todo el día, añade también el widget «Sonnerie Prof» a la pantalla bloqueada. iOS limita una Live Activity activa a unas 8 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un suivi fiable sur toute la journée, ajoutez aussi le widget « Sonnerie Prof » à l’écran verrouillé. iOS limite une Live Activity active à environ 8 heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per un monitoraggio affidabile durante tutta la giornata, aggiungi anche il widget «Sonnerie Prof» alla schermata di blocco. iOS limita una Live Activity attiva a circa 8 ore."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg voor betrouwbare weergave gedurende de hele dag ook de widget ‘Sonnerie Prof’ toe aan het toegangsscherm. iOS beperkt een actieve Live Activity tot ongeveer 8 uur."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby niezawodnie śledzić czas przez cały dzień, dodaj również widżet „Sonnerie Prof” do ekranu blokady. iOS ogranicza aktywną Live Activity do około 8 godzin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para acompanhar o dia todo com confiabilidade, adicione também o widget “Sonnerie Prof” à Tela Bloqueada. O iOS limita uma Atividade ao Vivo ativa a cerca de 8 horas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para um acompanhamento fiável durante todo o dia, adicione também o widget «Sonnerie Prof» ao ecrã bloqueado. O iOS limita uma Live Activity ativa a cerca de 8 horas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pentru o urmărire fiabilă pe tot parcursul zilei, adaugă și widgetul „Sonnerie Prof” pe ecranul blocat. iOS limitează o Live Activity activă la aproximativ 8 ore."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För tillförlitlig visning hela dagen lägger du även till widgeten ”Sonnerie Prof” på låsskärmen. iOS begränsar en aktiv Live Activity till cirka 8 timmar."
          }
        }
      }
    },
