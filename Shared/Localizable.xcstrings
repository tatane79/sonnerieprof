    "tip.support_about" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplikace Sonnerie Prof je zdarma a všechny její funkce jsou dostupné bez placení. Pokud chcete, můžete její vývoj podpořit dobrovolným spropitným."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sonnerie Prof er gratis, og alle funktioner er tilgængelige uden betaling. Hvis du har lyst, kan du støtte udviklingen med frivillige drikkepenge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sonnerie Prof ist kostenlos und alle Funktionen sind ohne Bezahlung verfügbar. Auf Wunsch kann die Entwicklung mit einem freiwilligen Trinkgeld unterstützt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sonnerie Prof is free, and all its features are available without payment. If you’d like, you can support its development with an optional tip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sonnerie Prof es gratuita y todas sus funciones están disponibles sin pagar. Si quieres, puedes apoyar su desarrollo con una propina opcional."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sonnerie Prof est gratuite et toutes ses fonctions sont disponibles sans paiement. Si vous le souhaitez, vous pouvez soutenir son développement avec un pourboire facultatif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sonnerie Prof è gratuita e tutte le sue funzioni sono disponibili senza alcun pagamento. Se vuoi, puoi sostenerne lo sviluppo con una mancia facoltativa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sonnerie Prof is gratis en alle functies zijn zonder betaling beschikbaar. Als je wilt, kun je de ontwikkeling steunen met een vrijwillige fooi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Aplikacja Sonnerie Prof jest bezpłatna, a wszystkie jej funkcje są dostępne bez opłat. Jeśli chcesz, możesz wesprzeć jej rozwój dobrowolnym napiwkiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O Sonnerie Prof é gratuito e todos os recursos estão disponíveis sem pagamento. Se quiser, você pode apoiar o desenvolvimento com uma gorjeta opcional."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sonnerie Prof é gratuita e todas as funcionalidades estão disponíveis sem qualquer pagamento. Se pretender, pode apoiar o desenvolvimento com uma gorjeta facultativa."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sonnerie Prof este gratuită și toate funcțiile sale sunt disponibile fără plată. Dacă doriți, puteți susține dezvoltarea acesteia printr-un bacșiș opțional."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sonnerie Prof är gratis och alla funktioner är tillgängliga utan betalning. Om du vill kan du stödja utvecklingen med frivillig dricks."
          }
        }
      }
