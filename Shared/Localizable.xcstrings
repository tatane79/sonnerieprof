    "La sauvegarde privée contient l’emploi du temps, les noms de semaines et vos établissements afin de préserver les liens entre les cours et leurs sites." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Soukromá záloha obsahuje rozvrh, názvy týdnů a vaše školy, aby zůstala zachována propojení mezi hodinami a jejich pracovišti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den private sikkerhedskopi indeholder skemaet, ugenavnene og skolerne, så forbindelserne mellem lektioner og deres steder bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Die private Sicherung enthält den Stundenplan, die Wochennamen und Ihre Schulen, damit die Verknüpfungen zwischen Unterrichtsstunden und ihren Standorten erhalten bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "The private backup contains your timetable, week names, and schools to preserve the links between classes and their locations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "La copia de seguridad privada contiene el horario, los nombres de las semanas y los centros educativos para conservar los vínculos entre las clases y sus centros."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Il backup privato contiene l’orario delle lezioni, i nomi delle settimane e le scuole per mantenere i collegamenti tra le lezioni e le relative sedi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "De privéreservekopie bevat het lesrooster, de weeknamen en je scholen, zodat de koppelingen tussen lessen en locaties behouden blijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Prywatna kopia zapasowa zawiera plan lekcji, nazwy tygodni i szkoły, aby zachować powiązania między lekcjami a ich placówkami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "O backup privado contém o horário, os nomes das semanas e as escolas para preservar os vínculos entre as aulas e os respectivos locais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "A cópia de segurança privada contém o horário, os nomes das semanas e as escolas, para preservar as ligações entre as aulas e os respetivos locais."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Copia de rezervă privată conține orarul, numele săptămânilor și școlile, pentru a păstra legăturile dintre cursuri și locațiile acestora."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Den privata säkerhetskopian innehåller schemat, veckonamnen och dina skolor så att kopplingarna mellan lektionerna och deras platser bevaras."
          }
        }
      }
    },
