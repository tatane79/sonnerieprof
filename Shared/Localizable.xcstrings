    "Pendant une suspension (vacances, fermeture, congé), aucune sonnerie n'est proposée avant la date de reprise." : {
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během pozastavení (prázdniny, uzavření nebo volno) nebudou před datem obnovení naplánována žádná zvonění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under en pause (ferie, lukning eller orlov) planlægges der ingen ringninger før genoptagelsesdatoen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während einer Pause (Ferien, Schließung oder Urlaub) werden bis zum Wiederaufnahmedatum keine Klingelzeiten vorgeschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While paused (holidays, closure or leave), no bells are scheduled before the resume date."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante una pausa (vacaciones, cierre o permiso), no se programará ningún timbre antes de la fecha de reanudación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant une suspension (vacances, fermeture, congé), aucune sonnerie n'est proposée avant la date de reprise."
